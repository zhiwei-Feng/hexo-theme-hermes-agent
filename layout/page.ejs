<% if (page.type === 'tags') { %>
  <%- partial('tag') %>
<% } else if (page.type === 'categories') { %>
  <%- partial('category') %>
<% } else { %>
  <article class="page post">
    <h1 class="post__title"><%= page.title %></h1>
    <div class="post-content"><%- page.content %></div>
  </article>
<% } %>
