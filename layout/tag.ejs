<section class="archive">
  <% const isIndex = !page.tag; %>

  <% if (isIndex) { %>
    <h2 class="archive__year"><%= __('nav.tags') %></h2>
    <%
      // Size-weight chips by post count so the cloud reads at a glance.
      const tagCounts = site.tags.toArray().map(function(t){ return t.length; });
      const maxCount = Math.max.apply(null, tagCounts.concat([1]));
    %>
    <div class="tag-cloud">
      <% site.tags.sort('-length').each(function(t) {
        const weight = t.length / maxCount;
        const size = (0.8 + weight * 0.8).toFixed(2);
      %>
        <a class="tag-chip" href="<%- url_for(t.path) %>" style="font-size: <%= size %>rem">
          #<%= t.name %><span class="tag-chip__count"> · <%= t.length %></span>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <h2 class="archive__year"><%= page.tag.toUpperCase() %> · <%= __('archive.year_posts').replace('{n}', page.posts.length) %></h2>
    <ul class="archive__list">
      <% page.posts.each(function(p) { %>
        <li class="archive__item">
          <span class="archive__date"><%= format_date_ymd(p.date) %></span>
          <a class="archive__title" href="<%- url_for(p.path) %>"><%= p.title %></a>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>
